[Unit]
Description=Nexora VPS paper bot watchdog
After=network-online.target nexora-proxy.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=%h/nexora-proxy
EnvironmentFile=-/etc/nexora/nexora.env
ExecStart=/bin/sh %h/nexora-proxy/nexora-watchdog.sh
Restart=always
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
